# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/
/.worktrees/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / open-next
/.open-next/
/.wrangler/
/cloudflare-env.d.ts
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data — populated by yt-dlp.
# We track public seed files (streams/shorts/channel) but never the
# admin-created manual events or auth cookies.
/data/manual.json
/data/admin-config.json
/data/sync-log.json
/data/youtube-cookies.txt

# claude code workspace
CLAUDE.md
AGENTS.md
.claude/
